[project]
name       = FOSSIL
version    = VERSION
summary    = FOrtran Stereo (si) Litography parser
repository = https://github.com/szaghi/FOSSIL
website    = https://szaghi.github.io/FOSSIL
email      = stefano.zaghi@gmail.it
authors    = Stefano Zaghi

[dependencies]
deps_dir   = src/third_party
BeFoR64    = https://github.com/szaghi/BeFoR64
FACE       = https://github.com/szaghi/FACE
FLAP       = https://github.com/szaghi/FLAP
FoXy       = https://github.com/Fortran-FOSS-Programmers/FoXy
PENF       = https://github.com/szaghi/PENF
StringiFor = https://github.com/szaghi/StringiFor
VTKFortran = https://github.com/szaghi/VTKFortran
VecFor     = https://github.com/szaghi/VecFor

[modes]
modes = shared-gnu static-gnu shared-gnu-debug static-gnu-debug
        shared-intel static-intel shared-intel-debug static-intel-debug
        tests-gnu tests-gnu-debug tests-gnu-openmp
        tests-intel tests-intel-debug
        static-nvidia tests-nvidia

# Variable sets. The nvidia modes (static-nvidia / tests-nvidia, issue #20
# Step 0) need nvfortran and a GPU compute-capability target ($NVF_CC). They
# are NOT built by CI and NOT validated on the standard dev host (no nvfortran
# there) -- they are manual-only: select the local_nvf varset explicitly, e.g.
#   fobis build --mode tests-nvidia --varset local_nvf
# The default varset is local_gnu, a no-op placeholder, so every existing
# GNU/Intel mode is completely unaffected. $NVF_CC mirrors ADAM's local_nvf
# (cc89); override it for a different GPU, e.g. --varset leonardo-style cc80.
[varsets]
default = local_gnu

[varset:local_gnu]

[varset:local_nvf]
$NVF_CC = cc89

[common-variables]
$CSHARED_GNU = -cpp -c -fPIC -frealloc-lhs
$CSHARED_INT = -cpp -c -fpic -assume realloc_lhs
$LSHARED     = -shared
$CSTATIC_GNU = -cpp -c -frealloc-lhs
$CSTATIC_INT = -cpp -c -assume realloc_lhs
$CSTATIC_NV  = -cpp -c -acc -gpu=$NVF_CC -Minfo=accel
$LSTATIC_NV  = -acc -gpu=$NVF_CC -Minfo=accel
$OPENMP_GNU  = -fopenmp
$DEBUG_GNU   = -O0 -g3 -Warray-bounds -Wcharacter-truncation -Wline-truncation -Wimplicit-interface -Wimplicit-procedure -Wunderflow -fcheck=all -fmodule-private -ffree-line-length-132 -fimplicit-none -fbacktrace -fdump-core -finit-real=nan -std=f2018 -fall-intrinsics
$DEBUG_INT   = -O0 -debug all -check all -warn all -extend-source 132 -traceback -gen-interfaces#-fpe-all=0 -fp-stack-check -fstack-protector-all -ftrapuv -no-ftz -std18
$OPTIMIZE    = -O2
$EXDIRS      = BeFoR64/src/tests/
               FACE/src/tests/
               FLAP/src/tests/
               FoXy/src/tests/
               PENF/src/tests/
               StringiFor/src/tests/
               VecFor/src/tests/
               VTKFortran/src/tests/
               VTKFortran/references/

# main modes
# GNU
[shared-gnu]
template  = template-shared-gnu
target    = fossil.f90
build_dir = ./shared/
output    = libfossil.so
mklib     = shared

[static-gnu]
template  = template-static-gnu
target    = fossil.f90
build_dir = ./static/
output    = libfossil.a
mklib     = static

[shared-gnu-debug]
template  = template-shared-gnu-debug
target    = fossil.f90
build_dir = ./shared/
output    = libfossil.so
mklib     = shared

[static-gnu-debug]
template  = template-static-gnu-debug
target    = fossil.f90
build_dir = ./static/
output    = libfossil.a
mklib     = static

[tests-gnu]
template  = template-static-gnu
build_dir = ./exe/

# OpenMP-enabled test build. Identical to tests-gnu but adds -fopenmp so the
# !$omp directives in distance_many (issue #19 §B3) activate. Without this mode
# the directives compile as inert comments and distance_many runs serially.
[tests-gnu-openmp]
template  = template-static-gnu-openmp
build_dir = ./exe/

[tests-gnu-debug]
template  = template-static-gnu-debug
build_dir = ./exe/

# Intel
[shared-intel]
template  = template-shared-intel
target    = fossil.f90
build_dir = ./shared/
output    = libfossil.so
mklib     = shared

[static-intel]
template  = template-static-intel
target    = fossil.f90
build_dir = ./static/
output    = libfossil.a
mklib     = static

[shared-intel-debug]
template  = template-shared-intel-debug
target    = fossil.f90
build_dir = ./shared/
output    = libfossil.so
mklib     = shared

[static-intel-debug]
template  = template-static-intel-debug
target    = fossil.f90
build_dir = ./static/
output    = libfossil.a
mklib     = static

[tests-intel]
template = template-static-intel
build_dir = ./exe/

[tests-intel-debug]
template  = template-static-intel-debug
build_dir = ./exe/

# NVIDIA (OpenACC device target, issue #20). nvfortran-only, manual build:
#   fobis build --mode static-nvidia --varset local_nvf
#   fobis build --mode tests-nvidia  --varset local_nvf
# Not in CI, not validated on the standard dev host -- see [varsets] comment.
[static-nvidia]
template  = template-static-nvidia
target    = fossil.f90
build_dir = ./static/
output    = libfossil.a
mklib     = static

[tests-nvidia]
template  = template-static-nvidia
build_dir = ./exe/

#templates
[template-shared-gnu]
compiler     = gnu
cflags       = $CSHARED_GNU $OPTIMIZE
lflags       = $LSHARED $OPTIMIZE
exclude_dirs = $EXDIRS
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
colors       = True
quiet        = False
log          = True
jobs         = 2

[template-static-gnu]
compiler     = gnu
cflags       = $CSTATIC_GNU $OPTIMIZE
exclude_dirs = $EXDIRS
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
colors       = True
quiet        = False
log          = True
jobs         = 2

[template-static-gnu-openmp]
compiler     = gnu
cflags       = $CSTATIC_GNU $OPTIMIZE $OPENMP_GNU
lflags       = $OPENMP_GNU
exclude_dirs = $EXDIRS
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
colors       = True
quiet        = False
log          = True
jobs         = 2

[template-shared-gnu-debug]
compiler     = gnu
cflags       = $CSHARED_GNU $DEBUG_GNU
lflags       = $LSHARED $DEBUG_GNU
exclude_dirs = $EXDIRS
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
colors       = True
quiet        = False
log          = True
jobs         = 2

[template-static-gnu-debug]
compiler     = gnu
cflags       = $CSTATIC_GNU $DEBUG_GNU
lflags       = $DEBUG_GNU
exclude_dirs = $EXDIRS
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
colors       = True
quiet        = False
log          = True
jobs         = 2

[template-shared-intel]
compiler     = intel
cflags       = $CSHARED_INT $OPTIMIZE
lflags       = $LSHARED $OPTIMIZE
exclude_dirs = $EXDIRS
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
colors       = True
quiet        = False
log          = True
jobs         = 2

[template-static-intel]
compiler     = intel
cflags       = $CSTATIC_INT $OPTIMIZE
lflags       = $OPTIMIZE
exclude_dirs = $EXDIRS
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
colors       = True
quiet        = False
log          = True
jobs         = 2

[template-shared-intel-debug]
compiler     = intel
cflags       = $CSHARED_INT $DEBUG_INT
lflags       = $LSHARED $DEBUG_INT
exclude_dirs = $EXDIRS
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
colors       = True
quiet        = False
log          = True
jobs         = 2

[template-static-intel-debug]
compiler     = intel
cflags       = $CSTATIC_INT $DEBUG_INT
lflags       = $DEBUG_INT
exclude_dirs = $EXDIRS
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
colors       = True
quiet        = False
log          = True
jobs         = 2

# NVIDIA (issue #20 Step 0). OpenACC device target via nvfortran. $NVF_CC comes
# from the local_nvf varset -- the build aborts if no varset providing it is
# selected, which is the intended guard against an accidental device build on a
# host without nvfortran.
[template-static-nvidia]
compiler     = nvfortran
cflags       = $CSTATIC_NV $OPTIMIZE
lflags       = $LSTATIC_NV $OPTIMIZE
exclude_dirs = $EXDIRS
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
colors       = True
quiet        = False
log          = True
jobs         = 2

# rules
[rule-makedoc]
help   = Build documentation with formal + VitePress
rule_1 = formal generate --mirror-sources --diagrams --project docs/ford.md --output docs/api
rule_2 = cd docs && npm ci && npm run docs:build

[rule-deldoc]
help = Delete documentation build artifacts
rule = rm -rf docs/.vitepress/dist/ docs/.vitepress/cache/ docs/api/

[rule-delexe]
help = Delete exes
rule = rm -rf exe/

[rule-clean]
help = Clean the project tree
rule_1 = FoBiS.py rule -ex deldoc
rule_2 = FoBiS.py rule -ex delexe
rule_3 = rm -f *.gcov

[rule-maketar]
help = Make tar archive of the project
rule = tar --xform="s%^%FOSSIL/%" -czf FOSSIL.tar.gz *

[rule-makecoverage]
help   = Perform coverage analysis
rule_1 = FoBiS.py rule -ex delexe
rule_2 = FoBiS.py build -mode tests-gnu-debug -coverage
rule_3 = ./scripts/run_tests.sh
rule_4 = rm -f exe/obj/befor64* exe/obj/face* exe/obj/flap* exe/obj/foxy* exe/obj/penf* exe/obj/stringifor* exe/obj/vecfor* exe/obj/vtk*
rule_5 = ./scripts/compute-coverage.sh

[rule-makecoverage-analysis]
help   = Perform coverage analysis and saving reports in markdown
rule_1 = FoBiS.py rule -ex makecoverage
rule_2 = FoBiS.py rule --gcov-analyzer docs/guide/ --gcov-analyzer coverage-analysis
rule_3 = rm -f *.gcov
